# Environment configuration template for adaptive_cartpole
# Copy this to .env and fill in your values
# .env files are git-ignored and should NOT be committed

# Your Rutgers netID (used to construct paths)
NET_ID=your_netid_here

# Base path for user directories (typically /common/users/)
USER_BASE=/common/users

# Base path for arcmg datasets
ARCMG_DATASETS_BASE=/common/users/${NET_ID}/arcmg_datasets

# Project base path
PROJECT_BASE=/common/users/${NET_ID}/adaptive_cartpole

# Shared data path (same for all users)
SHARED_DATA_BASE=/common/users/shared/pracsys/genMoPlan/data_trajectories
