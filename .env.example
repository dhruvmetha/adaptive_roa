# Environment configuration for adaptive sampling pipeline
# Copy this to .env and fill in your values
# .env files are git-ignored and should NOT be committed
#
# These variables are used by Hydra configs via resolvers:
#   ${project_base:}     → PROJECT_BASE
#   ${shared_data_base:} → SHARED_DATA_BASE

# Project output directory - where experiment outputs are saved
# Used by: output_dir in all adaptive configs
PROJECT_BASE=/common/users/YOUR_NETID/adaptive_tripods

# Shared trajectory data - read-only, same for all users
# Used by: data_source paths in all adaptive configs
SHARED_DATA_BASE=/common/users/shared/pracsys/genMoPlan/data_trajectories
