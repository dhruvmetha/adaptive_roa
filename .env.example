# Environment configuration for adaptive sampling pipeline
# Copy this to .env and fill in your values
# .env files are git-ignored and should NOT be committed
#
# These variables are used by Hydra configs via resolvers:
#   ${exp_dir:}  → EXP_DIR
#   ${data_dir:} → DATA_DIR

# Experiment output directory - where experiment outputs are saved
# Used by: output_dir in all adaptive configs
EXP_DIR=/common/users/shared/pracsys/adaptive_roa_experiments

# Trajectory data directory - read-only, same for all users
# Used by: data_source paths in all adaptive configs
DATA_DIR=/common/users/shared/pracsys/genMoPlan/data_trajectories