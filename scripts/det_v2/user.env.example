# Per-user settings for the det_v2 launch/resume scripts.
# Copy to scripts/det_v2/user.env (gitignored) and fill in the <...> values.
# Every det_v2 script sources it through common.sh; DET_V2_USER_ENV=<path> picks another file.
# Bash syntax: KEY=value, ${OTHER_KEY} expands, no spaces around "=".

# ---- identity and code -------------------------------------------------------------
# Unix / net id. Goes into the ledger's user column, squeue -u, TMPDIR names and the
# snapshot's .env.
NET_ID=<netid>
# The conda env's python. The env needs the flow_matching sibling installed editable
# (github.com/Ewerton-Vieira/flow_matching at 2ec0f34). Jobs run it with
# PYTHONPATH=<snapshot> and PYTHONNOUSERSITE=1.
PYTHON=/common/users/<netid>/envs/adaptive_roa/bin/python
# Read-only code snapshots, one dir per commit (snapshot.sh). Keep it per user and
# off /common/home if the other account must read your runs' code.
SNAPSHOT_DIR=/common/users/<netid>/det_v2_code
# Optional: the clone launch.sh snapshots from. Default: the repo holding these scripts.
#DET_V2_REPO=/common/users/<netid>/adaptive_roa

# ---- data and outputs (also written into each snapshot's .env) ----------------------
DATA_DIR=/common/users/shared/pracsys/genMoPlan/data_trajectories
SHARED_DATA_BASE=${DATA_DIR}
# Run dirs land at ${EXP_DIR}/det_v2/<setting>/<name>_s<seed>, from each run's config.
# The shared campaign root ${EXP_DIR}/det_v2 is group login-bekris and setgid.
EXP_DIR=/common/users/shared/pracsys/adaptive_roa_experiments
# Optional: env_config.py's USER_BASE (unused by det_v2 runs).
#USER_BASE=/common/users/shared/pracsys/genMoPlan/global_dynamics_experiments

# ---- shared campaign files (defaults shown; both accounts must use the same ones) ---
# Launched ledger, appended under flock by every launch and resume.
#LEDGER=${EXP_DIR}/det_v2/launched.tsv
# Job logs (iLab .out/.err, direct .log, the Amarel log mirror) and direct command files.
#LOG_DIR=${EXP_DIR}/det_v2/logs
# Direct hosts rebalance.py never moves a run onto, one per line, # comments allowed.
#HOLD_HOSTS=${EXP_DIR}/det_v2/hold_hosts.txt
# Group that must read the data and the outputs (preflight.py, rsync --chmod).
#SHARED_GROUP=login-bekris
# Per-job TMPDIR goes under here as <NET_ID>_<job id or run name>.
#TMP_ROOT=/tmp

# ---- iLab SLURM ---------------------------------------------------------------------
ILAB_SUBMIT_HOST=ilab1.cs.rutgers.edu
#ILAB_PARTITION=unlimited
# Known-bad nodes; DET_V2_EXCLUDE=<list> replaces it for one call (rebalance pins the home node).
#ILAB_EXCLUDE=ilab3,ilab4
# OMP/MKL threads for the Part-X CPU jobs (launch.sh <name> ilabcpu).
#ILAB_CPU_THREADS=8
# Wall for iLab resumes (rebalance.py); short walls fit the backfill window. Default 06:00:00.
#ILAB_RESUME_WALL=06:00:00

# ---- direct boxes (westeros, arrakis, perception = 1spring-303-desktop-10) -----------
# ssh target is <host>${DIRECT_HOST_SUFFIX}.
#DIRECT_HOST_SUFFIX=.cs.rutgers.edu
# CPU pinning per host, space-separated host=cpulist (perception shares its CPUs).
#DIRECT_TASKSET="1spring-303-desktop-10=0-9"
# Optional extra registry of direct runs (host pid gpu name log ts cmd), e.g. the one
# the compute skill reads. Empty: none.
#DIRECT_JOBS_TSV=
# Cards other users' jobs also run on that you were cleared to use for one det_v2 run
# each, space-separated host:gpu. rebalance.py counts them free while no det_v2 run holds them.
#SHARED_CARDS="arrakis:3 arrakis:4"
# Placement scan rebalance.py runs (`gpu-free.sh --fit <vram> <mem>`).
#GPU_FREE=$HOME/.claude/skills/compute/scripts/gpu-free.sh
# 1 clears SSH_AUTH_SOCK for every ssh (westeros's agent hangs key auth). Leave 0 if you
# authenticate through an agent.
SSH_CLEAR_AGENT=0

# ---- Amarel -------------------------------------------------------------------------
# Separate filesystem: code arrives by git (origin github.com/dhruvmetha/adaptive_roa),
# runs write to scratch, sync_amarel.sh mirrors them into ${EXP_DIR}/det_v2.
AMAREL_HOST=amarel.rutgers.edu
# Amarel login for squeue -u (default NET_ID).
#AMAREL_USER=<netid>
AMAREL_ACCOUNT=general
# Clone that fetches launched commits (its origin must hold them: push first).
AMAREL_CLONE=/home/<netid>/Projects/adaptive_roa
AMAREL_PYTHON=/home/<netid>/Projects/adaptive_roa/env/bin/python
AMAREL_SNAPSHOT_DIR=/home/<netid>/det_v2_code
# Amarel twin of EXP_DIR: a run dir ${EXP_DIR}/det_v2/... runs at ${AMAREL_EXP_DIR}/det_v2/...
AMAREL_EXP_DIR=/scratch/<netid>/adaptive_roa/experiments
# Staged data (DATA_DIR and SHARED_DATA_BASE in the Amarel snapshot's .env). launch.sh
# refuses an Amarel launch whose data files are not staged here.
AMAREL_DATA_DIR=/scratch/<netid>/genMoPlan-exp/data_trajectories
AMAREL_LOG_DIR=/home/<netid>/det_v2_logs
#AMAREL_PARTITION=gpu
# ECC-faulty cards; never use the cgpu partition (no /scratch).
#AMAREL_EXCLUDE=gpu029,gpu046
#AMAREL_CPUS=4
